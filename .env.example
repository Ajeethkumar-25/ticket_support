# Roosterly Helpdesk API
HELPDESK_BASE_URL=https://nakywgkztvzkihdjnwbc.supabase.co/functions/v1/helpdesk
HELPDESK_API_KEY=your_helpdesk_key_from_email_here
CANDIDATE_EMAIL=your_email@example.com

# LLM Configuration (groq or gemini)
LLM_PROVIDER=groq

# Groq API (Recommended: fast, reliable, generous free tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini API (Alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Runtime & Reliability
REQUEST_RATE_LIMIT=4.5
MAX_RETRIES=5
LOG_FILE=logs/tickets.log
STATE_FILE=data/state.json
